# ── Database (Supabase PostgreSQL) ───────────────────────────
DATABASE_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your-supabase-db-password

# ── JWT (generate with: openssl rand -base64 64) ─────────────
# Must be at least 512 bits (64 chars base64). NEVER commit this.
JWT_SECRET=replace-with-64-char-random-secret-generated-by-openssl-rand

# ── OTP HMAC (generate with: openssl rand -base64 32) ────────
OTP_HMAC_SECRET=replace-with-32-char-random-secret

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── SMTP (Gmail example) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password  # Use App Password, not account password

# ── App URLs ──────────────────────────────────────────────────
APP_BASE_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ── Cookies ───────────────────────────────────────────────────
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true   # Must be true in production (HTTPS only)

# ── Redis (for rate limiting) ──────────────────────────────────
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your-redis-password

# ── Frontend (.env) ────────────────────────────────────────────
REACT_APP_API_BASE_URL=https://api.yourdomain.com
